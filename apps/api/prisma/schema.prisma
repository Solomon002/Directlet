generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------

// HUNTER is a house hunter: browses, messages landlords. Becomes TENANT when
// a landlord gives them a tenancy. ADMIN runs the platform; it is never
// self-registered, only granted with the admin:grant script.
enum UserRole {
  LANDLORD
  TENANT
  HUNTER
  ADMIN
}

enum RentFrequency {
  MONTHLY
  QUARTERLY
  BIANNUAL
  ANNUAL
}

enum TenancyStatus {
  ACTIVE
  ENDED
}

// ---------- Models ----------

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique
  passwordHash    String?
  googleId        String?   @unique
  role            UserRole
  fullName        String
  phone           String?
  emailVerifiedAt DateTime?
  idDocumentPath  String?
  inviteToken     String?   @unique
  inviteExpiresAt DateTime?
  // Set by an admin. A suspended user cannot log in, and a suspended
  // landlord's properties disappear from the marketplace.
  suspendedAt     DateTime?
  suspendedReason String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  properties Property[]
  tenancies  Tenancy[]
  paymentsRecorded  Payment[] @relation("PaymentRecordedBy")
  paymentsConfirmed Payment[] @relation("PaymentConfirmedBy")
  complaintsRaised Complaint[]
  auditLogs        AuditLog[]
  refreshTokens     RefreshToken[]
  conversationsAsLandlord    Conversation[] @relation("ConversationLandlord")
  conversationsAsParticipant Conversation[] @relation("ConversationParticipant")
  messagesSent               Message[]
  inspectionRequests         InspectionRequest[] @relation("InspectionRequester")
  verification               LandlordVerification? @relation("VerificationOwner")
  verificationsReviewed      LandlordVerification[] @relation("VerificationReviewer")
  emailVerifications         EmailVerification[]
  reportsMade                Report[] @relation("ReportReporter")
  reportsHandled             Report[] @relation("ReportHandler")
  reviewsWritten             Review[]
}

// ---------- Email confirmation ----------

// A link sent by email. Only a hash of the token is stored, so a database leak does
// not hand out working links. A used or expired row is simply deleted.
model EmailVerification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------- Reports and reviews ----------

enum ReportReason {
  FAKE_LISTING
  STOLEN_PHOTOS
  ASKED_FOR_MONEY
  WRONG_PRICE
  ALREADY_LET
  ABUSIVE
  OTHER
}

enum ReportStatus {
  OPEN
  ACTION_TAKEN
  DISMISSED
}

// A signed-in person saying a listing is not what it should be. An admin reviews it.
// Several reports from different people hide the listing until an admin looks.
model Report {
  id             String       @id @default(uuid()) @db.Uuid
  reporterId     String       @db.Uuid
  propertyId     String       @db.Uuid
  reason         ReportReason
  details        String?
  status         ReportStatus @default(OPEN)
  resolutionNote String?
  handledById    String?      @db.Uuid
  handledAt      DateTime?
  createdAt      DateTime     @default(now())

  reporter  User     @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  property  Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  handledBy User?    @relation("ReportHandler", fields: [handledById], references: [id], onDelete: SetNull)

  @@index([propertyId, status])
  @@index([status, createdAt])
}

// Only someone who really saw the place (a completed viewing, or a tenancy) can review
// it. The landlord can answer but not delete; an admin can remove an abusive one.
model Review {
  id               String    @id @default(uuid()) @db.Uuid
  propertyId       String    @db.Uuid
  reviewerId       String    @db.Uuid
  rating           Int
  matchedPhotos    Boolean
  priceAsStated    Boolean
  comment          String?
  landlordResponse String?
  respondedAt      DateTime?
  removedAt        DateTime?
  createdAt        DateTime  @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  reviewer User     @relation(fields: [reviewerId], references: [id], onDelete: Cascade)

  @@unique([reviewerId, propertyId])
  @@index([propertyId, createdAt])
}

// ---------- Listing photos ----------

// A picture of a property, or of one flat in it (unitId). position 0 is the cover.
// Kept in the database like verification documents, so it needs no extra service;
// a photo is served by its own id and never changes, so browsers and the CDN cache it.
model PropertyPhoto {
  id          String   @id @default(uuid()) @db.Uuid
  propertyId  String   @db.Uuid
  unitId      String?  @db.Uuid
  position    Int
  contentType String
  sizeBytes   Int
  // SHA-256 of the file. The same file cannot be used on another landlord's listing,
  // which catches the plainest case of stolen photos.
  contentHash String
  data        Bytes
  createdAt   DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unit     Unit?    @relation(fields: [unitId], references: [id], onDelete: SetNull)

  @@index([propertyId, position])
  @@index([contentHash])
}

// ---------- Landlord verification ----------

// There is no row for a landlord who has not applied: that means "unverified".
enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum LandlordType {
  INDIVIDUAL
  COMPANY
}

// The prefix of a CAC (Corporate Affairs Commission) registration number:
// RC a company, BN a registered business name, IT incorporated trustees.
enum CacType {
  RC
  BN
  IT
}

enum VerificationDocKind {
  ID
  OWNERSHIP
  CAC_CERTIFICATE
}

// One application per landlord. An admin checks the documents (and, for a company,
// the CAC number on search.cac.gov.ng) and approves or rejects it.
model LandlordVerification {
  id              String             @id @default(uuid()) @db.Uuid
  userId          String             @unique @db.Uuid
  status          VerificationStatus @default(PENDING)
  landlordType    LandlordType
  cacType         CacType?
  cacNumber       String?
  // The name as the landlord says it is registered; the admin compares it with CAC.
  registeredName  String?
  submittedAt     DateTime           @default(now())
  reviewedAt      DateTime?
  // Set only while the status is VERIFIED. The marketplace sorts on it so verified
  // landlords come first (reviewedAt cannot do that, since a rejection sets it too).
  verifiedAt      DateTime?
  reviewedById    String?            @db.Uuid
  rejectionReason String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  user      User                   @relation("VerificationOwner", fields: [userId], references: [id], onDelete: Cascade)
  reviewer  User?                  @relation("VerificationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  documents VerificationDocument[]

  @@index([status])
}

// Kept in the database, like payment proofs, so it has the same backups and access
// checks. Only the landlord and admins can read one. Size is capped at upload time.
model VerificationDocument {
  id             String              @id @default(uuid()) @db.Uuid
  verificationId String              @db.Uuid
  kind           VerificationDocKind
  fileName       String
  contentType    String
  sizeBytes      Int
  data           Bytes
  createdAt      DateTime            @default(now())

  verification LandlordVerification @relation(fields: [verificationId], references: [id], onDelete: Cascade)

  @@index([verificationId])
}

model Property {
  id          String   @id @default(uuid()) @db.Uuid
  landlordId  String   @db.Uuid
  name        String
  address     String
  area        String
  city        String
  state       String
  description String?
  isPublic    Boolean  @default(true)
  // Set by the landlord (pin on a map or their phone's location). Optional:
  // a property without one simply has no map or directions.
  latitude    Float?
  longitude   Float?
  // Set by an admin (e.g. a scam listing). Overrides isPublic: the landlord
  // cannot re-list it until an admin clears this.
  hiddenByAdminAt     DateTime?
  hiddenByAdminReason String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  landlord      User           @relation(fields: [landlordId], references: [id])
  units         Unit[]
  conversations Conversation[]
  photos        PropertyPhoto[]
  reports       Report[]
  reviews       Review[]

  @@index([landlordId])
  @@index([city, area])
}

// Unit status (vacant/occupied) is derived from tenancies, never stored.
model Unit {
  id            String        @id @default(uuid()) @db.Uuid
  propertyId    String        @db.Uuid
  label         String
  bedrooms      Int
  bathrooms     Int?
  rentAmount    Decimal       @db.Decimal(14, 2)
  rentFrequency RentFrequency @default(ANNUAL)
  description   String?
  // One-off costs on top of the rent. Null means the landlord has not said, which
  // the public pages show as "Ask landlord"; 0 means there is no such fee.
  cautionDeposit Decimal?     @db.Decimal(14, 2)
  agreementFee   Decimal?     @db.Decimal(14, 2)
  serviceCharge  Decimal?     @db.Decimal(14, 2)
  agencyFee      Decimal?     @db.Decimal(14, 2)
  // The last time the landlord said this flat is still available. A vacant flat
  // that has gone too long without it stops being offered (see availability.ts).
  availabilityConfirmedAt DateTime @default(now())
  // For a flat that is let now but will be free on this date.
  availableFrom DateTime?     @db.Date
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  property  Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenancies Tenancy[]
    inspectionRequests InspectionRequest[]
  photos    PropertyPhoto[]

  @@unique([propertyId, label])
  @@index([propertyId])
}

// Rent amount and frequency are snapshotted here when the tenancy is created.
model Tenancy {
  id              String        @id @default(uuid()) @db.Uuid
  unitId          String        @db.Uuid
  tenantId        String        @db.Uuid
  rentAmount      Decimal       @db.Decimal(14, 2)
  rentFrequency   RentFrequency
  startDate       DateTime      @db.Date
  rentExpiryDate  DateTime?     @db.Date
  status          TenancyStatus @default(ACTIVE)
  endedAt         DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  unit   Unit @relation(fields: [unitId], references: [id])
  tenant User @relation(fields: [tenantId], references: [id])
  rentCharges RentCharge[]
  payments    Payment[]
  complaints         Complaint[]
  inspectionRequest  InspectionRequest?

  @@index([unitId])
  @@index([tenantId])
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
  OTHER
}

// What is owed for one rent period. Charge status (paid/part-paid/overdue)
// is derived from amountPaid and dueDate, never stored.
model RentCharge {
  id          String   @id @default(uuid()) @db.Uuid
  tenancyId   String   @db.Uuid
  periodStart DateTime @db.Date
  periodEnd   DateTime @db.Date
  dueDate     DateTime @db.Date
  amount      Decimal  @db.Decimal(14, 2)
  // Denormalized: always recomputed by the same service that manages allocations.
  amountPaid  Decimal  @default(0) @db.Decimal(14, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenancy     Tenancy             @relation(fields: [tenancyId], references: [id], onDelete: Cascade)
  allocations PaymentAllocation[]

  @@unique([tenancyId, periodStart])
  @@index([tenancyId])
  @@index([dueDate])
}

// Money the tenant says they paid. Not tied to a single charge.
model Payment {
  id              String        @id @default(uuid()) @db.Uuid
  tenancyId       String        @db.Uuid
  amount          Decimal       @db.Decimal(14, 2)
  method          PaymentMethod @default(BANK_TRANSFER)
  paidAt          DateTime
  reference       String?
  proofPath       String?
  status          PaymentStatus @default(PENDING)
  recordedById    String        @db.Uuid
  confirmedById   String?       @db.Uuid
  confirmedAt     DateTime?
  rejectionReason String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  tenancy     Tenancy             @relation(fields: [tenancyId], references: [id])
  recordedBy  User                @relation("PaymentRecordedBy", fields: [recordedById], references: [id])
  confirmedBy User?               @relation("PaymentConfirmedBy", fields: [confirmedById], references: [id])
  allocations PaymentAllocation[]
  receipt     Receipt?
  proof       PaymentProof?

  @@index([tenancyId])
  @@index([status])
}

// The tenant's evidence for a payment (transfer screenshot or bank PDF).
// Stored in the database so it is covered by the same backups and access
// checks as the payment itself. Size is capped at upload time.
model PaymentProof {
  id          String   @id @default(uuid()) @db.Uuid
  paymentId   String   @unique @db.Uuid
  contentType String
  sizeBytes   Int
  data        Bytes
  createdAt   DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
}

// Links a payment to the charges it covers (one payment can cover several).
model PaymentAllocation {
  id           String   @id @default(uuid()) @db.Uuid
  paymentId    String   @db.Uuid
  rentChargeId String   @db.Uuid
  amount       Decimal  @db.Decimal(14, 2)
  createdAt    DateTime @default(now())

  payment    Payment    @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  rentCharge RentCharge @relation(fields: [rentChargeId], references: [id])

  @@unique([paymentId, rentChargeId])
  @@index([rentChargeId])
}

// One receipt per confirmed payment. The PDF is regenerated on request.
model Receipt {
  id            String   @id @default(uuid()) @db.Uuid
  paymentId     String   @unique @db.Uuid
  receiptNumber String   @unique
  issuedAt      DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id])
}
enum ComplaintStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum InspectionStatus {
  PENDING
  SCHEDULED
  COMPLETED
  DECLINED
  CONVERTED
  // Ended by the visitor before it happened.
  CANCELLED
  // The date passed and one side did not turn up.
  NO_SHOW_VISITOR
  NO_SHOW_LANDLORD
}

// Raised by a tenant, managed by the landlord.
model Complaint {
  id           String          @id @default(uuid()) @db.Uuid
  tenancyId    String          @db.Uuid
  raisedById   String          @db.Uuid
  title        String
  description  String
  status       ComplaintStatus @default(OPEN)
  landlordNote String?
  resolvedAt   DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  tenancy  Tenancy @relation(fields: [tenancyId], references: [id], onDelete: Cascade)
  raisedBy User    @relation(fields: [raisedById], references: [id])

  @@index([tenancyId])
  @@index([status])
}

// Submitted by a public visitor, so there is no user account behind it.
// convertedTenancyId is set when the landlord turns the request into a tenancy.
model InspectionRequest {
  id                 String           @id @default(uuid()) @db.Uuid
  unitId             String           @db.Uuid
  name               String
  email              String
  phone              String
  message            String?
  preferredDate      DateTime?
  scheduledFor       DateTime?
  status             InspectionStatus @default(PENDING)
  landlordNote       String?
  convertedTenancyId String?          @unique @db.Uuid
  // The signed-in person who asked. Null on older requests made before an account
  // was needed. While set, their phone and email stay hidden from the landlord
  // until the landlord accepts.
  requesterId        String?          @db.Uuid
  // The rent as it was when they asked, so a later change can be pointed out to them.
  rentAmount         Decimal?         @db.Decimal(14, 2)
  rentFrequency      RentFrequency?
  rescheduleCount    Int              @default(0)
  cancelledAt        DateTime?
  // When the "viewing tomorrow" reminder emails went out, so they go out once.
  reminderSentAt     DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  unit             Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  convertedTenancy Tenancy? @relation(fields: [convertedTenancyId], references: [id])
  requester        User?    @relation("InspectionRequester", fields: [requesterId], references: [id], onDelete: SetNull)

  @@index([requesterId])
  @@index([unitId])
  @@index([status])
}

// Written by middleware on every state-changing request, never by hand.
// userId is optional because public requests have no logged-in user.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @db.Uuid
  method     String
  path       String
  statusCode Int
  entity     String?
  entityId   String?
  ip         String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
}
// One thread between a landlord and one other person (a house hunter or a
// tenant) about one property. unitId records which flat the chat started about.
// Each side's last-read time drives the unread counts.
model Conversation {
  id                    String    @id @default(uuid()) @db.Uuid
  propertyId            String    @db.Uuid
  unitId                String?   @db.Uuid
  landlordId            String    @db.Uuid
  participantId         String    @db.Uuid
  lastMessageAt         DateTime  @default(now())
  landlordLastReadAt    DateTime?
  participantLastReadAt DateTime?
  createdAt             DateTime  @default(now())

  property    Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  landlord    User      @relation("ConversationLandlord", fields: [landlordId], references: [id], onDelete: Cascade)
  participant User      @relation("ConversationParticipant", fields: [participantId], references: [id], onDelete: Cascade)
  messages    Message[]

  @@unique([propertyId, participantId])
  @@index([landlordId, lastMessageAt])
  @@index([participantId, lastMessageAt])
}

model Message {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @db.Uuid
  senderId       String   @db.Uuid
  body           String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// One row per page a visitor opens. No cookies and no IP address: visitorHash
// is a hash of IP + browser + a salt that changes daily, so a visitor can be
// counted once per day but never tracked across days or identified.
model PageView {
  id          String   @id @default(uuid()) @db.Uuid
  day         DateTime @db.Date
  path        String
  referrer    String?
  visitorHash String
  createdAt   DateTime @default(now())

  @@index([day])
  @@index([day, visitorHash])
}

// One row per refresh token issued. The row id is the token jti.
// Tokens are single-use: using one revokes it and issues the next in the same family.
// Presenting a revoked token means it was copied, so the whole family is revoked.
model RefreshToken {
  id        String    @id @db.Uuid
  userId    String    @db.Uuid
  familyId  String    @db.Uuid
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}
